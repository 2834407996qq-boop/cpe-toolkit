#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
PROG=/usr/bin/cpe_tunnel.sh

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    procd_kill 2>/dev/null
    for p in $(ps w | grep 'cpe_tunnel.sh' | grep -v grep | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null
    done
    # 顺带清理残留的 ssh 隧道进程
    for p in $(ps w | grep 'id_ed25519_tunnel' | grep -v grep | awk '{print $1}'); do
        kill -9 "$p" 2>/dev/null
    done
    sleep 1
}
