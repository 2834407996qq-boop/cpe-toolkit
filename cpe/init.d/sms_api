#!/bin/sh /etc/rc.common
#!/bin/sh /etc/rc.common
START=97
STOP=10
USE_PROCD=1
PROG=/usr/bin/sms_api.py
start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 "$PROG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
stop_service() {
    procd_kill 2>/dev/null
    for p in $(ps w | grep sms_api.py | grep -v grep | awk '{print $1}'); do kill -9 "$p" 2>/dev/null; done
}
