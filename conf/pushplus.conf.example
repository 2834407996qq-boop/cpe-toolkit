# ============================================================
# 短信转发配置  ——  复制到 /etc/pushplus.conf 后按需修改
# ============================================================

# ---------- PushPlus 微信推送（可选，留空则只推自建服务）----------
TOKEN=

# 过滤模式：off=全推  whitelist=只推含关键词的  blacklist=过滤掉含关键词的
FILTER_MODE=whitelist

# 关键词（逗号分隔）
FILTER_KEYWORDS=验证码,验证密码,扣费,充值,银行,支付,订单

# 1=转发成功后删除短信（防止 SIM 卡存满 100 条导致新短信进不来）
AUTO_DELETE=1

# ---------- 推送节流与重试（避免触发服务端频率限制）----------
PUSH_GAP=2        # 每条推送之间的间隔秒数
PUSH_RETRY=3      # 限流时的最大重试次数
PUSH_BACKOFF=6    # 限流后的退避等待秒数

# ---------- 自建短信网关（可选）----------
# 需与服务器端 /opt/sms/config.json 里的 token 一致
SERVER_URL=
SERVER_TOKEN=

# ---------- 短信串口（一般不用改，服务会自动探测）----------
# SMS_PORT=/dev/ttyUSB3
