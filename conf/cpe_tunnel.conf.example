# ============================================================
# SSH 反向隧道配置  ——  复制到 /etc/cpe_tunnel.conf
# 用途：CPE 在运营商 NAT 后无公网 IP，由 CPE 主动连出到你的服务器
# ============================================================

# 【必填】你的服务器，格式 user@host
TUNNEL_SERVER=root@your.server.com

# 隧道私钥（由安装脚本生成）
TUNNEL_KEY=/root/.ssh/id_ed25519_tunnel

# 转发规则，空格分隔。格式：<服务器端口>:<CPE地址>:<CPE端口>
#   18111 → LuCI 后台(80)
#   18112 → 短信 API(18998)，仅当部署了短信网关时需要
TUNNEL_FORWARDS="18111:127.0.0.1:80 18112:127.0.0.1:18998"

# 断线重连间隔（秒）
RETRY=10
